<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtt_ros2_test_msgs</name>
  <version>0.0.0</version>
  <description>RTT typekit and transport plugins for test_msgs</description>
  <maintainer email="orocos-dev@orocos.org">Orocos Developers</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>rtt_ros2_interfaces</test_depend>
  <test_depend>test_msgs</test_depend>

  <!-- Runtime dependencies of the generated typekit/transport plugins
       (see the rtt_ros2_plugin_depends ament resource). They must be
       exec_depend so that colcon adds them to the runtime environment of
       downstream test packages. -->
  <exec_depend>rtt_ros2_primitives_typekit</exec_depend>
  <exec_depend>rtt_ros2_builtin_interfaces</exec_depend>
  <exec_depend>rtt_ros2_node</exec_depend>
  <exec_depend>rtt_ros2_topics</exec_depend>
  <exec_depend>rtt_ros2_services</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
